# Keep this shared workspace repository limited to the distributable project.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/docs/
/docs/*
!/docs/images/
/docs/images/*
!/docs/images/performance.png
!/docs/images/deepseek.png
!/docs/images/music.png
!/independent-clock/
/independent-clock/*
!/independent-clock/*.cs
!/independent-clock/clock.ps1
!/independent-clock/HardwareInfo.ps1
!/independent-clock/CpuFrequency.ps1
!/independent-clock/Install-Sensors.ps1
!/independent-clock/test-audio-spectrum.ps1
!/independent-clock/test-cpu-frequency.ps1
!/independent-clock/version.json
!/independent-clock/cpu-frequency-profiles.json
!/independent-clock/dependencies.json
!/independent-clock/device-profiles.example.json
!/independent-clock/HubMonitor.ico
!/independent-clock/monitor-load-metrics.md
!/independent-clock/tactical-spectrum.md
!/independent-clock/assets/
/independent-clock/assets/*
!/independent-clock/assets/deepseek-clock.png
!/independent-clock/assets/chatgpt-source.jfif
!/independent-clock/assets/zh-CN.json
!/independent-clock/native/
/independent-clock/native/*
!/independent-clock/native/libusb-1.0.dll
!/independent-clock/sensors/
/independent-clock/sensors/*
!/independent-clock/sensors/*.dll
!/independent-clock/sensors/licenses/
!/independent-clock/sensors/driver/
/independent-clock/sensors/driver/*
!/independent-clock/sensors/driver/PawnIO_setup.exe
!/independent-clock/sensors/driver/COPYING.json
!/independent-clock/packaging/
/independent-clock/packaging/*
!/independent-clock/packaging/*.ps1
!/independent-clock/packaging/*.cs
!/independent-clock/packaging/release-README.md
!/independent-clock/packaging/release-CHANGELOG.md
!/independent-clock/packaging/THIRD-PARTY-NOTICES.txt
!/independent-clock/packaging/COPYING-libusb.txt
/independent-clock/*.backup.cs

# Defense in depth: credentials and machine-specific outputs are never tracked.
**/.env
**/.env.*
**/auth.json
**/preferences.json
**/device-profiles.json
**/*.log
**/*.pdb
**/stage-*/
**/payload-*.zip
